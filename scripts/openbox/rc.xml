<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
    <keepBorder>yes</keepBorder>
  </theme>
  <margins top="0" bottom="0" left="0" right="0"/>
  <applications>
    <application class="*">
      <maximized>true</maximized>
    </application>
  </applications>
</openbox_config>
